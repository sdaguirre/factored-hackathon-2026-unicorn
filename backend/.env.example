# Copie a .env (nunca lo suba al repositorio). Todas las variables tienen prefijo CHAT_.
CHAT_ENV=dev

# Claves de integracion: lista separada por comas. Vacio = sin clave (solo local).
CHAT_API_KEYS=
# Clave de la consola de agentes (GET /v1/handoffs). Obligatoria si CHAT_ENV != dev.
CHAT_ADMIN_API_KEYS=
# Secreto de los tokens de sesion (>= 32 caracteres). Si falta, se genera uno temporal al arrancar.
CHAT_JWT_SECRET=
# Origenes permitidos para un sitio web externo, separados por comas
CHAT_CORS_ORIGINS=

# Proveedor de LLM: mock (sin red ni clave) | anthropic
CHAT_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
CHAT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Mensajes que el LLM puede reescribir (lista por comas, 'none' = ninguno, vacio = valores por defecto)
CHAT_LLM_REWRITE_KINDS=

# Ofertas aceptadas (filas de gold credit_offers, JSONL). scripts/sync_credit_offers.py las sube a Databricks.
# Vacio = carpeta temporal del sistema (en el contenedor, /tmp).
# CHAT_OFFERS_PATH=../.local/credit_offers.jsonl

# Fuente de datos: snapshot (parquet local, por defecto) | databricks (silver y gold reales por SQL Warehouse).
# Con databricks las ofertas aceptadas tambien se escriben en <gold>.credit_offers (el JSONL sigue de respaldo).
# Credenciales en el contenedor: DATABRICKS_HOST + DATABRICKS_TOKEN (o DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET).
# En desarrollo: CHAT_DATABRICKS_PROFILE con un perfil del CLI (databricks auth login).
CHAT_REPOSITORY=snapshot
# CHAT_DATABRICKS_WAREHOUSE_ID=
# CHAT_DATABRICKS_PROFILE=
# CHAT_DATABRICKS_SILVER_SCHEMA=workspace.silver_latam_bank
# CHAT_DATABRICKS_GOLD_SCHEMA=workspace.gold_latam_bank
# CHAT_DATABRICKS_WRITE_OFFERS=true
# CHAT_DATABRICKS_CACHE_SECONDS=300
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=

CHAT_SESSION_TTL_MINUTES=30
CHAT_AUTH_MAX_ATTEMPTS=3
CHAT_AUTH_LOCKOUT_MINUTES=15
